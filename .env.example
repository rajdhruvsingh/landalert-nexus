# =============================================================================
# LandAlert-Nexus — Environment Variable Manifest
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# FRONTEND PUBLIC — Injected at Vite build time (VITE_ prefix).
# Safe to expose in client-side JavaScript bundles.
# Set these on the Render Static Site service under "Environment".
# -----------------------------------------------------------------------------

# Supabase project REST URL (public)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase publishable (anon) key — safe for browser
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# Supabase project ID
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# -----------------------------------------------------------------------------
# BACKEND PRIVATE — Read at Node.js server runtime only.
# Never build these into the Vite client bundle.
# Set these on the Render Web Service under "Environment".
# -----------------------------------------------------------------------------

# Supabase REST URL (server-side)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase service-role key — bypasses RLS, NEVER expose to frontend
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Supabase publishable key (server fallback if service role unavailable)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# PostgreSQL connection string used by Python ML inference (inference.py)
# On Render: set to the Supabase Postgres connection string (pooler recommended)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_ID:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Secret used to authenticate cron/ingest webhook endpoints (/api/ingest-weather, /api/recompute)
# Generate a random 32+ character string: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-secret

# -----------------------------------------------------------------------------
# OPTIONAL — Set only if needed
# -----------------------------------------------------------------------------

# Previous cron secret during rotation (allows zero-downtime key rotation)
# CRON_SECRET_PREVIOUS=old-cron-secret

# Override Nitro server port (Render injects PORT automatically; do not set on Render)
# PORT=3000

# Override Nitro bind host (Render requirement: must bind to 0.0.0.0 — already default)
# HOST=0.0.0.0

# Simulation controls (default: false; enable only in staging/test environments)
ENABLE_SIMULATION=false

# -----------------------------------------------------------------------------
# DEPLOYMENT — Render-specific settings
# These are handled by render.yaml; document here for reference only.
# -----------------------------------------------------------------------------

# NITRO_PRESET — must be "node-server" for Render deployment
# Set in render.yaml build command: NITRO_PRESET=node-server npm run build

# NODE_VERSION — Render reads this from .node-version or package.engines
# NODE_ENV=production — set automatically by Render on web services
